# Copy this file to backend.hcl and fill in your values.
# backend.hcl is gitignored — never commit it.
# Generated automatically by scripts/setup-env.sh.
#
# Get your account ID: aws sts get-caller-identity --query Account --output text
# Get/confirm your region: aws configure get region

bucket         = "petclinic-tfstate-ACCOUNT_ID-REGION"
region         = "REGION"
dynamodb_table = "petclinic-terraform-locks"
encrypt        = true
